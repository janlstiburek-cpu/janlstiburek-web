---
import "../../styles/fonts.css";

const services = [
  {
    name: "Orchestral arrangements",
    description: "Songs and existing music arranged for symphony or chamber orchestra — from a lead sheet, a demo or a finished recording. Crossover is my main field.",
  },
  {
    name: "Orchestration & new instrumental parts",
    description: "Orchestrating your sketches, or writing new parts for solo instruments and ensembles that fit your music and your idea of the sound.",
  },
  {
    name: "Scores and parts for recording and concerts",
    description: "Engraved full scores and parts, checked and ready for the session or the stage. Audio mock-ups on request.",
  },
  {
    name: "Original music",
    description: "Music for film, theatre and live shows.",
  },
];

const projects = [
  {
    name: "Klusymfonie",
    listen: { url: "https://open.spotify.com/album/037waxSZR7SumdwEtpagYM", label: "Spotify" },
    role: "Arranger",
    year: "2019–",
    facts: ["Janáček Philharmonic Ostrava", "Tomáš Klus", "Supraphon"],
    description: "16 songs by Tomáš Klus, one of the most popular Czech singer-songwriters, arranged for symphony orchestra. The album was released before the first tour; the programme has since been performed with several orchestras.",
  },
  {
    name: "Richard Krajčo & orchestra",
    listen: { url: "https://open.spotify.com/album/3Emj8U2cz8BEXe2wVnmX2v", label: "Spotify" },
    role: "Arranger",
    year: "2025",
    facts: ["Hradec Králové Philharmonic", "Janáček Philharmonic Ostrava", "8 sold-out concerts", "live album"],
    description: "Christmas tour of the frontman of the Czech band Kryštof, for symphony orchestra, choir, vocals and rhythm section.",
  },
  {
    name: "Christmas at O2 arena Prague",
    listen: { url: "https://www.youtube.com/watch?v=ZjFQ-8OZD5E", label: "Video" },
    role: "Arranger · concert concept",
    year: "2023, 2025",
    facts: ["Hradec Králové Philharmonic", "children's and adult choirs"],
    description: "A Christmas show in the largest indoor arena in the Czech Republic, with seven leading Czech singers including Richard Krajčo, opera singer Adam Plachetka and Tomáš Klus.",
  },
  {
    name: "Tribute to David Stypka",
    listen: { url: "https://www.ceskatelevize.cz/porady/15437185493-k-pocte-davida-stypky/", label: "Czech TV" },
    role: "Arranger",
    year: "2023–",
    facts: ["Janáček Philharmonic Ostrava", "Ewa Farna", "Czech Television"],
    description: "18 songs by the late singer-songwriter David Stypka arranged for orchestra — a memorial concert by his closest musical friends, broadcast by Czech Television.",
  },
  {
    name: "Velký finále PSO",
    role: "Composer",
    year: "2024",
    facts: ["dir. Dominik Kalivoda", "Festival President's Award, Zlín Film Festival"],
    description: "Feature documentary about an amateur orchestra from a small Czech town and its journey to a big final concert.",
  },
  {
    name: "Branický zázrak",
    listen: { url: "https://open.spotify.com/album/6dZ65aFVusoDA9SG5l6F7g", label: "Spotify" },
    role: "Arranger · music director",
    year: "2022",
    facts: ["Na Fidlovačce Theatre Prague", "Jan Svěrák", "Tomáš Klus"],
    description: "Original musical by Oscar-winning film director Jan Svěrák (Kolya), with songs by Tomáš Klus, who also plays the lead.",
  }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Jan Lstibůrek — orchestral arranger and composer</title>
    <meta name="description" content="Jan Lstibůrek — Czech orchestral arranger, orchestrator and composer specialising in crossover: popular music for symphony orchestra. Working remotely with artists worldwide." />
    <link rel="canonical" href="https://www.janlstiburek.cz/en/" />
    <link rel="alternate" hreflang="cs" href="https://www.janlstiburek.cz/" />
    <link rel="alternate" hreflang="en" href="https://www.janlstiburek.cz/en/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content="https://www.janlstiburek.cz/en/" />
    <meta property="og:site_name" content="Jan Lstibůrek" />
    <meta property="og:title" content="Jan Lstibůrek — orchestral arranger and composer" />
    <meta property="og:description" content="Crossover for symphony orchestra — arrangements, orchestration, scores and parts for recording and concerts." />
    <meta property="og:image" content="https://www.janlstiburek.cz/og.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Jan Lstibůrek in concert" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>

    <header>
      <nav>
        <a href="#work">Work</a>
        <a href="#projects">Projects</a>
        <a href="#bio">Bio</a>
        <a href="#contact">Contact</a>
        <a href="/" lang="cs">CZ</a>
      </nav>
    </header>

    <main>

      <!-- HERO -->
      <section id="hero">
        <h1>Jan Lstibůrek</h1>
        <p class="tagline">I write for orchestras&nbsp;&nbsp;|&nbsp;&nbsp;compose&nbsp;&nbsp;|&nbsp;&nbsp;play bass</p>
        <img src="/foto-hero.jpg" alt="Jan Lstibůrek at the conductor's desk" class="hero-photo" />
      </section>

      <!-- WORK -->
      <section id="work">
        <h2>What I do</h2>
        <div class="projects">
          {services.map((s) => (
            <article class="project">
              <div class="project-header">
                <span class="project-name">{s.name}</span>
              </div>
              <p class="project-desc">{s.description}</p>
            </article>
          ))}
          <p class="project-desc">
            I work remotely — communication in English by email and video call.
          </p>
        </div>
      </section>

      <!-- PROJECTS -->
      <section id="projects">
        <h2>Selected projects</h2>
        <div class="projects">
          {projects.map((p) => (
            <article class="project">
              <div class="project-header">
                <span class="project-name">{p.name}</span>
                <span class="project-meta">{p.role}&ensp;·&ensp;{p.year}</span>
              </div>
              <p class="project-facts">{p.facts.join("  ·  ")}</p>
              <p class="project-desc">{p.description}</p>
              {p.listen && (
                <a class="project-listen" href={p.listen.url} target="_blank" rel="noopener">▶&ensp;{p.listen.label}</a>
              )}
            </article>
          ))}
        </div>
      </section>

      <!-- BIO -->
      <section id="bio">
        <h2>Bio</h2>
        <img src="/foto-bio.jpg" alt="Jan Lstibůrek playing bass guitar" class="bio-photo" />
        <p class="bio-text">
          Jan Lstibůrek is a Czech orchestral arranger, orchestrator and composer. He specialises
          in crossover — bringing popular music together with the symphony orchestra — and writes
          custom arrangements for orchestras, artists, concert productions and theatre. He works
          with the Janáček Philharmonic Ostrava, the Hradec Králové Philharmonic, the Moravian
          Philharmonic Olomouc and other Czech orchestras, and with leading Czech artists such as
          Tomáš Klus, Richard Krajčo and Jiří Korn.
          He studied at the Jaroslav Ježek Conservatory in Prague and at the Conservatorium
          van Amsterdam (2005).
          Alongside composing and arranging, he is an active bass player.
        </p>
      </section>

      <!-- CONTACT -->
      <section id="contact">
        <h2>Contact</h2>
        <div class="contact-links">
          <a href="mailto:jan.lstiburek@gmail.com" class="contact-link">jan.lstiburek@gmail.com</a>
          <a href="https://www.instagram.com/janlstiburek" class="contact-link" target="_blank" rel="noopener">Instagram</a>
        </div>
      </section>

    </main>

    <footer>
      <p>© {new Date().getFullYear()} Jan Lstibůrek&ensp;·&ensp;Photo: Martin Kusyn&ensp;·&ensp;<a href="/ochrana-osobnich-udaju/">Privacy policy (in Czech)</a></p>
    </footer>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --color-bg: #655d5b;
    --color-text: #ffffff;
    --color-muted: rgba(255,255,255,0.8);
    --color-border: rgba(255,255,255,0.2);
    --font: 'Jost', system-ui, sans-serif;
    --font-mono: 'Source Code Pro', monospace;
    --max-width: 820px;
    --spacing: clamp(3rem, 8vw, 6rem);
  }

  html {
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  body {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* NAV */
  header {
    padding: 2rem 0 0;
  }

  nav {
    display: flex;
    gap: 2rem;
    justify-content: flex-end;
  }

  nav a {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-muted);
    text-decoration: none;
    letter-spacing: 0.06em;
    transition: color 0.15s;
  }

  nav a:hover {
    color: var(--color-text);
  }

  /* HERO */
  #hero {
    padding: var(--spacing) 0 calc(var(--spacing) * 0.75);
    border-bottom: 1px solid var(--color-border);
    text-align: center;
  }

  h1 {
    font-size: clamp(2.25rem, 6.5vw, 4.5rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.0;
    margin-bottom: 1.25rem;
  }

  .tagline {
    font-family: var(--font-mono);
    font-size: clamp(0.85rem, 1.8vw, 0.9rem);
    font-weight: 400;
    color: var(--color-muted);
    letter-spacing: 0.08em;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  /* SECTIONS */
  section {
    padding: var(--spacing) 0;
    border-bottom: 1px solid var(--color-border);
  }

  h2 {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 2.5rem;
  }

  /* PROJECTS */
  .projects {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .project {
    display: grid;
    gap: 0.25rem;
  }

  .project-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .project-name {
    font-size: 1.125rem;
    font-weight: 500;
  }

  .project-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-muted);
    white-space: nowrap;
    letter-spacing: 0.04em;
  }

  .project-facts {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-muted);
    letter-spacing: 0.04em;
    line-height: 1.7;
    white-space: pre-wrap;
    margin-bottom: 0.4rem;
  }

  .project-desc {
    font-size: 0.9375rem;
    color: #ffffff;
    line-height: 1.65;
  }

  .project-listen {
    justify-self: start;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2px;
    transition: border-color 0.15s;
  }

  .project-listen:hover {
    border-color: var(--color-text);
  }

  /* PŘIPRAVUJI */
  .upcoming {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .upcoming-item {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: baseline;
  }

  .upcoming-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .upcoming-body {
    display: grid;
    gap: 0.25rem;
  }

  /* PHOTOS */
  .hero-photo {
    display: block;
    width: 100%;
    margin-top: 2.5rem;
    aspect-ratio: 5 / 2;
    object-fit: cover;
    object-position: center 10%;
  }

  .bio-photo {
    display: block;
    width: 100%;
    margin-bottom: 2rem;
    aspect-ratio: 5 / 2;
    object-fit: cover;
    object-position: center 55%;
  }

  /* BIO */
  .bio-text {
    font-size: 1rem;
    line-height: 1.8;
    color: rgba(255,255,255,0.85);
    max-width: 640px;
  }

  /* KONTAKT */
  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-link {
    font-size: 1.125rem;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.75rem;
    transition: border-color 0.15s, color 0.15s;
  }

  .contact-link:last-child {
    border-bottom: none;
  }

  .contact-link:hover {
    border-color: var(--color-text);
  }

  /* FOOTER */
  footer a {
    color: inherit;
    text-decoration: none;
  }

  footer a:hover {
    color: var(--color-text);
  }

  footer {
    padding: 2rem 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-muted);
    letter-spacing: 0.06em;
  }

  /* MOBILE */
  @media (max-width: 480px) {
    body {
      padding: 0 1.25rem;
    }

    .project-header {
      flex-direction: column;
      gap: 0.1rem;
    }

    .upcoming-item {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
